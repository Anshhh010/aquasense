# ==============================================================================
# AquaSense Environment Configuration Example
# Copy this file to '.env.local' for local development:
#   copy .env.example .env.local
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# --- Next.js Web Dashboard Configuration ---
# Optional: Override the default AWS API Gateway endpoint
NEXT_PUBLIC_AWS_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com

# Optional: Override the default local ESP32 sensor endpoint
NEXT_PUBLIC_DEFAULT_ESP32_URL=http://192.168.1.100/api/sensors

# --- AWS SNS Notification Module Configuration (aws/AWS_SNS.py) ---
# Required for AWS SNS publishing (in Lambda environment variables or local runner)
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:AquaSenseWaterQualityAlerts
AWS_REGION=ap-south-1

# Optional: AWS SDK credentials (only if running locally outside an IAM Role)
# In production / AWS Lambda, use execution IAM roles instead of static keys.
# AWS_ACCESS_KEY_ID=your_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
